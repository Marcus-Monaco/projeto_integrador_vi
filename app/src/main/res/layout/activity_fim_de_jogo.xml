<?xml version="1.0" encoding="utf-8"?>
<!-- WF-14 Fim de jogo / Vitoria: um layout, duas variantes -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingEnd="32dp">

    <TextView
        android:id="@+id/titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.08"
        android:textColor="@color/texto"
        android:textSize="32sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/subtitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/texto_secundario"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:background="@drawable/fundo_cartao"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            style="@style/Rotulo"
            android:text="@string/pontuacao_final" />

        <TextView
            android:id="@+id/valorPontos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/primario"
            android:textSize="40sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/niveis_concluidos"
                android:textColor="@color/texto_secundario" />

            <TextView
                android:id="@+id/valorNiveis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/texto"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tijolos_destruidos"
                android:textColor="@color/texto_secundario" />

            <TextView
                android:id="@+id/valorTijolos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/texto"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/melhor_pontuacao"
                android:textColor="@color/texto_secundario" />

            <TextView
                android:id="@+id/valorMelhor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/texto"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/botaoJogarNovamente"
        style="@style/Botao.Primario"
        android:layout_marginTop="32dp"
        android:text="@string/jogar_novamente" />

    <Button
        android:id="@+id/botaoMenu"
        style="@style/Botao.Secundario"
        android:layout_marginTop="16dp"
        android:text="@string/menu_principal" />
</LinearLayout>
