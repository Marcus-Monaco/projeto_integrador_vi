<?xml version="1.0" encoding="utf-8"?>
<!-- WF-13 Pausa -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/veu_70"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:background="@drawable/fundo_cartao"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="@string/pausa"
            android:textColor="@color/texto"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pausaResumo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:textColor="@color/texto_secundario" />

        <Button
            android:id="@+id/botaoContinuar"
            style="@style/Botao.Primario"
            android:layout_height="58dp"
            android:textSize="16sp"
            android:text="@string/continuar" />

        <Button
            android:id="@+id/botaoReiniciarPausa"
            style="@style/Botao.Secundario"
            android:layout_marginTop="12dp"
            android:text="@string/reiniciar_nivel" />

        <Button
            android:id="@+id/botaoConfiguracoesPausa"
            style="@style/Botao.Secundario"
            android:layout_marginTop="12dp"
            android:text="@string/configuracoes" />

        <Button
            android:id="@+id/botaoSairPausa"
            style="@style/Botao.Terciario"
            android:layout_marginTop="16dp"
            android:text="@string/sair_para_o_menu" />
    </LinearLayout>
</FrameLayout>
