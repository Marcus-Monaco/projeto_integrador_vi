<?xml version="1.0" encoding="utf-8"?>
<!-- WF-05 Tela de jogo: SurfaceView em tela cheia, HUD de 44 dp como View comum por cima e as sobreposicoes -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo">

    <br.edu.ucs.brickbreaker.jogo.JogoView
        android:id="@+id/jogoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- HUD: nivel, pontos, vidas e pausa -->
    <LinearLayout
        android:id="@+id/hud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/hud"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Rotulo"
                    android:textSize="9sp"
                    android:text="@string/hud_rotulo_nivel" />

                <TextView
                    android:id="@+id/hudNivel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/texto"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    style="@style/Rotulo"
                    android:textSize="9sp"
                    android:text="@string/hud_rotulo_pontos" />

                <TextView
                    android:id="@+id/hudPontos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/texto"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    style="@style/Rotulo"
                    android:textSize="9sp"
                    android:text="@string/hud_rotulo_vidas" />

                <TextView
                    android:id="@+id/hudVidas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/alerta"
                    android:textSize="14sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/botaoPausa"
                android:layout_width="48dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/pausar"
                android:src="@drawable/ic_pausa" />
        </LinearLayout>
    </LinearLayout>

    <!-- contagem curta ao retomar da pausa -->
    <TextView
        android:id="@+id/textoRetomar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="@color/texto"
        android:textSize="72sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <include
        android:id="@+id/overlayTransicao"
        layout="@layout/overlay_transicao"
        android:visibility="gone" />

    <include
        android:id="@+id/overlayPausa"
        layout="@layout/overlay_pausa"
        android:visibility="gone" />

    <include
        android:id="@+id/overlayPerdida"
        layout="@layout/overlay_bola_perdida"
        android:visibility="gone" />
</FrameLayout>
